# Public Supabase browser configuration. Never put service_role or database credentials here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional cross-app URLs. Local development defaults to Admin :5173 and POS :5174.
VITE_ADMIN_URL=http://localhost:5173
VITE_POS_URL=http://localhost:5174
