# Public Supabase browser configuration. Never put service_role or database credentials here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Cross-app links. In development they default to Admin :5173 and POS :5174.
# In production set both: when missing, the link is hidden instead of pointing to localhost.
#   VITE_ADMIN_URL is read by the POS (link "Administración", owner/admin only).
#   VITE_POS_URL is read by Admin (link "Ir al POS" and the redirect of staff users).
VITE_ADMIN_URL=http://localhost:5173
VITE_POS_URL=http://localhost:5174
